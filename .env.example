APP_NAME=Nexo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nexo
DB_USERNAME=postgres
DB_PASSWORD=

# Base de datos que usan las pruebas (ver phpunit.xml)
# DB_DATABASE_PRUEBAS=nexo_pruebas

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo (documento 2, sección 5.5).
#
# En local se manda al log a propósito: así se puede recorrer el flujo entero
# —proceso diario, cola, registro de envíos y panel de alertas— sin credenciales
# de ningún proveedor y sin riesgo de escribirle a un correo real de un cliente.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# En producción, en cambio, las alertas NO salen del servidor de la aplicación:
# salen de un proveedor transaccional. Es una condición del producto, no una
# preferencia técnica —una alerta que cae en spam es igual de útil que una que
# no se envió—, y los tres candidatos del documento 2 hablan SMTP, así que
# cambiar de uno a otro es cambiar estas cinco líneas:
#
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=tls
#   MAIL_HOST=smtp.postmarkapp.com     # o smtp.resend.com, o email-smtp.<region>.amazonaws.com
#   MAIL_PORT=587
#   MAIL_USERNAME=<el token del proveedor>
#   MAIL_PASSWORD=<el token del proveedor>
#   MAIL_FROM_ADDRESS="alertas@<el dominio propio>"
#
# Y falta la mitad que no está en este archivo, porque vive en el DNS del
# dominio: SPF, DKIM y DMARC. Sin los tres, el proveedor entrega y el buzón de
# destino clasifica el correo como sospechoso igual.
#
# Para comprobarlo, con la empresa ya creada:
#
#   php artisan alertas:prueba <id o NIT de la empresa> <correo>
#
# El correo sale por el mismo camino que las alertas de verdad y queda en el
# registro de envíos, que se consulta en la sección Alertas del sistema.

# Monitoreo de errores (documento 6, A.5).
#
# En local no hace falta: los errores ya se ven en el log y en `pail`. En
# producción, una excepción que nadie capturó tiene que llegar aquí con su
# traza completa, no quedarse solo en el archivo de log del servidor.
#
# Para activarlo: crea el proyecto en https://sentry.io (plan gratuito),
# copia su DSN y agrega estas dos líneas —la segunda mete el canal nuevo en
# la pila de logging sin quitar el archivo local—:
#
#   SENTRY_LARAVEL_DSN=<el DSN del proyecto>
#   LOG_STACK=single,sentry

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Solo en producción (docs/08-despliegue.md). En local no hacen falta. ---
# NEXO_ROL=web                # qué proceso es este contenedor: web, worker o scheduler
# DB_URL=                     # el rol de la aplicación, NUNCA el superusuario
# DB_URL_ADMIN=               # el superusuario, solo para crear ese rol; se borra tras el primer despliegue
# DISCO_CERTIFICADOS=local    # dónde se guardan los certificados de Cámara de Comercio
# SENTRY_LARAVEL_DSN=         # sin él, los errores de producción no llegan a ninguna parte
